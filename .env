# Environment Configuration for FDM 3D Printer Technical Training Portal

APP_NAME="FDM 3D Printer Technical Training Module"
APP_SHORT_NAME="3D Print Academy"
APP_TAGLINE="Learn. Design. Print. Innovate."
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/3D%20Printing%20Technical%20Training%20&%20Learning%20Portal

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=3d_printer_portal
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_LIFETIME=7200
CSRF_SECRET=fdm3d_sec_key_2026_educational_portal_slaf_tech_trg
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# File Upload Constraints (in bytes: 10MB = 10485760)
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_DOC_TYPES=application/pdf,application/zip,application/x-zip-compressed
